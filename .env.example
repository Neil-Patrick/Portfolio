# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Add the same variables in Vercel: Project Settings > Environment Variables.

# GitHub token for the home page's GitHub activity section (contribution
# calendar, commit and PR counts). Server-only: it is never sent to the browser.
# Create a fine-grained token with "Public repositories (read-only)" access and
# no extra permissions. Without it, the section falls back to public stats.
GITHUB_TOKEN=
